diff --git a/app/src/test/java/com/droiddeck/launcher/gpu/DriverPackEntryTest.kt b/app/src/test/java/com/droiddeck/launcher/gpu/DriverPackEntryTest.kt
new file mode 100644
index 0000000..6609fae
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/gpu/DriverPackEntryTest.kt
@@ -0,0 +1,124 @@
+package com.droiddeck.launcher.gpu
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import java.io.File
+import java.nio.file.Files
+
+/**
+ * Which library inside an imported pack the loader should open.
+ *
+ * The importer used to accept exactly one file name, which was fine while Turnip was the only driver
+ * anyone could import. A CPU renderer arrives as a directory of libraries, so the entry point has to
+ * be chosen rather than assumed.
+ */
+// Robolectric, because the install check parses the manifest with org.json: the plain JVM test
+// classpath only has Android's stubbed copy, which throws on construction.
+@RunWith(RobolectricTestRunner::class)
+class DriverPackEntryTest {
+
+    private fun libs(vararg names: String) = names.associateWith { File(it) }
+
+    @Test fun aPackThatNamesItsEntryPointGetsIt() {
+        val pack = libs("libvulkan_lvp.so", "libLLVM-11.so.1", "libdrm.so.2")
+        assertEquals("libvulkan_lvp.so", LinuxVulkanDriverManager.pickEntry(pack, "libvulkan_lvp.so"))
+    }
+
+    @Test fun aDeclaredEntryThatIsNotThereIsNotSilentlyReplaced() {
+        // Better to fail the import than to open a different library than the pack asked for.
+        val pack = libs("libvulkan_lvp.so", "libLLVM-11.so.1")
+        assertNull(LinuxVulkanDriverManager.pickEntry(pack, "libvulkan_freedreno.so"))
+    }
+
+    @Test fun aTurnipPackWithoutAManifestStillWorks() {
+        // Every pack published before this change looks like this, and must keep importing.
+        assertEquals("libvulkan_freedreno.so", LinuxVulkanDriverManager.pickEntry(libs("libvulkan_freedreno.so"), ""))
+        assertEquals(
+            "libvulkan_freedreno.so",
+            LinuxVulkanDriverManager.pickEntry(libs("libLLVM-11.so.1", "libvulkan_freedreno.so"), ""),
+        )
+    }
+
+    @Test fun aCpuRendererPackWithoutAManifestIsRecognised() {
+        assertEquals(
+            "libvulkan_lvp.so",
+            LinuxVulkanDriverManager.pickEntry(libs("libLLVM-11.so.1", "libvulkan_lvp.so"), ""),
+        )
+    }
+
+    /**
+     * The version the generated manifest declares.
+     *
+     * Declaring 1.1 for a 1.4 driver is not cosmetic: the loader treats the driver as 1.1, and a
+     * compositor that requires 1.3 then reports no physical device while the driver is loaded and
+     * enumerable. Measured on a Kirin 9010 with lavapipe 26.2.
+     */
+    @Test fun aPackStatesItsOwnVulkanVersion() {
+        assertEquals("1.4.0", LinuxVulkanDriverManager.apiVersion("1.4.0"))
+    }
+
+    @Test fun aPackThatSaysNothingKeepsTheHistoricalVersion() {
+        // Every Turnip pack published so far looks like this and must import unchanged.
+        assertEquals("1.1.274", LinuxVulkanDriverManager.apiVersion(null))
+        assertEquals("1.1.274", LinuxVulkanDriverManager.apiVersion(""))
+        assertEquals("1.1.274", LinuxVulkanDriverManager.apiVersion("  "))
+    }
+
+    @Test fun aMalformedVersionFallsBackRatherThanWritingGarbage() {
+        // A manifest with an unparsable version makes the loader drop the whole ICD.
+        assertEquals("1.1.274", LinuxVulkanDriverManager.apiVersion("1.4"))
+        assertEquals("1.1.274", LinuxVulkanDriverManager.apiVersion("latest"))
+    }
+
+    @Test fun aPackWithNoVulkanDriverIsRefused() {
+        assertNull(LinuxVulkanDriverManager.pickEntry(libs("libLLVM-11.so.1", "libdrm.so.2"), ""))
+        assertNull(LinuxVulkanDriverManager.pickEntry(emptyMap(), ""))
+    }
+
+    /**
+     * An installed pack is recognised by what its own manifest points at.
+     *
+     * The first version of this checked for `libvulkan_freedreno.so` by name, which meant a
+     * correctly imported CPU renderer existed on disk and was invisible in the driver list.
+     */
+    @Test fun anInstallIsRecognisedByItsManifestNotAFixedFileName() {
+        val dir = Files.createTempDirectory("lvd-manifest").toFile()
+        try {
+            val lib = File(dir, "libvulkan_lvp.so").apply { writeText("not a real library") }
+            // Forward slashes: a Windows temp path in a JSON string needs escaping otherwise, and
+            // Android paths look like this anyway.
+            val path = lib.absolutePath.replace('\\', '/')
+            File(dir, "icd.json").writeText("""{"ICD":{"library_path":"$path"}}""")
+            assertEquals(lib.absolutePath, LinuxVulkanDriverManager.libraryOf(dir)?.absolutePath)
+        } finally {
+            dir.deleteRecursively()
+        }
+    }
+
+    @Test fun anOlderInstallWithTheFixedNameStillCounts() {
+        val dir = Files.createTempDirectory("lvd-legacy").toFile()
+        try {
+            val lib = File(dir, LinuxVulkanDriverManager.LIB_NAME).apply { writeText("x") }
+            // No manifest at all: the historical layout is all there is to go on.
+            assertEquals(lib.absolutePath, LinuxVulkanDriverManager.libraryOf(dir)?.absolutePath)
+        } finally {
+            dir.deleteRecursively()
+        }
+    }
+
+    @Test fun aManifestPointingAtNothingFallsBackRatherThanClaimingInstalled() {
+        val dir = Files.createTempDirectory("lvd-broken").toFile()
+        try {
+            File(dir, "icd.json").writeText("""{"ICD":{"library_path":"/nowhere/libvulkan_lvp.so"}}""")
+            assertNull(LinuxVulkanDriverManager.libraryOf(dir))
+            // And with the legacy name present, the fallback still finds it.
+            val legacy = File(dir, LinuxVulkanDriverManager.LIB_NAME).apply { writeText("x") }
+            assertEquals(legacy.absolutePath, LinuxVulkanDriverManager.libraryOf(dir)?.absolutePath)
+        } finally {
+            dir.deleteRecursively()
+        }
+    }
+}
diff --git a/app/src/test/java/com/droiddeck/launcher/gpu/KirinSupportTierTest.kt b/app/src/test/java/com/droiddeck/launcher/gpu/KirinSupportTierTest.kt
new file mode 100644
index 0000000..b316d40
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/gpu/KirinSupportTierTest.kt
@@ -0,0 +1,53 @@
+package com.droiddeck.launcher.gpu
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The tiers a Kirin device lands in, and the words it is shown.
+ *
+ * Mali is UNTESTED rather than UNSUPPORTED because an imported PanVK driver can drive it; Maleoon is
+ * UNSUPPORTED for hardware but must not be told "buy a Snapdragon", because the session does run -
+ * on the CPU.
+ */
+class KirinSupportTierTest {
+
+    private fun info(family: GpuInfo.Family, name: String = "x") =
+        GpuInfo(name = name, model = 0, family = family, soc = "", oneUi8Gen2 = false)
+
+    @Test fun maliIsExperimentalNotUnsupported() {
+        val mali = info(GpuInfo.Family.MALI, "Mali-G78 MP24")
+        assertEquals(GpuInfo.Support.UNTESTED, mali.support)
+        assertTrue(mali.supportText.contains("PanVK"))
+        assertTrue(mali.supportText.contains("not validated"))
+    }
+
+    @Test fun maleoonSaysSoftwareNotUnsupportedGpu() {
+        val maleoon = info(GpuInfo.Family.MALEOON, "Maleoon 910")
+        assertEquals(GpuInfo.Support.UNSUPPORTED, maleoon.support)
+        assertTrue(maleoon.supportText.contains("CPU rendering"))
+        // The old line would be technically true and practically useless here.
+        assertTrue(!maleoon.supportText.contains("Snapdragon"))
+    }
+
+    @Test fun aVendorWithNoBackendKeepsTheOldWording() {
+        // Xclipse, PowerVR and an unnamed GPU all stay NOT_ADRENO, so this wording is what they get.
+        assertEquals("Not supported: DroidDeck needs an Adreno (Snapdragon) GPU", info(GpuInfo.Family.NOT_ADRENO).supportText)
+    }
+
+    @Test fun adrenoTiersAreUntouched() {
+        // Same assertions the existing GpuDetectionTest makes, restated here so a change to the
+        // shared `support` rule cannot pass by only one of the two files.
+        val tested = GpuInfo("Adreno 830", 830, GpuInfo.familyOf(true, 830), "", false)
+        assertEquals(GpuInfo.Support.TESTED, tested.support)
+        assertEquals("Supported", tested.supportText)
+        val unknown = GpuInfo("Adreno", 0, GpuInfo.familyOf(true, 0), "", false)
+        assertEquals(GpuInfo.Support.UNTESTED, unknown.support)
+    }
+
+    @Test fun theVendorDefaultsToQualcommSoOldConstructionStillMeansAdreno() {
+        val gpu = GpuInfo("Adreno 740", 740, GpuInfo.Family.A7XX, "", false)
+        assertEquals(com.droiddeck.launcher.gpu.probe.GpuVendor.QUALCOMM, gpu.vendor)
+    }
+}
diff --git a/app/src/test/java/com/droiddeck/launcher/gpu/probe/BackendSelectionTest.kt b/app/src/test/java/com/droiddeck/launcher/gpu/probe/BackendSelectionTest.kt
new file mode 100644
index 0000000..792885d
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/gpu/probe/BackendSelectionTest.kt
@@ -0,0 +1,121 @@
+package com.droiddeck.launcher.gpu.probe
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class BackendSelectionTest {
+
+    private val adreno = GpuProbe.probe(
+        FakeEnv(files = setOf(DriverPaths.KGSL), contents = mapOf("/sys/class/kgsl/kgsl-3d0/gpu_model" to "Adreno740"))
+    )
+
+    private val maliCsf = GpuProbe.probe(
+        FakeEnv(
+            files = setOf(DriverPaths.MALI_DEV, DriverPaths.MALI_CSF),
+            contents = mapOf(DriverPaths.MALI_CSF to "1"),
+            vulkanDeviceName = "Mali-G615 MC6",
+        )
+    )
+
+    private val kirin9000 = GpuProbe.probe(
+        FakeEnv(files = setOf(DriverPaths.MALI_DEV), props = mapOf("ro.board.platform" to "kirin9000"))
+    )
+
+    private val kirin9000s = GpuProbe.probe(
+        FakeEnv(props = mapOf("ro.board.platform" to "kirin9000s"))
+    )
+
+    @Test fun adrenoIsUnchangedInEveryPolicy() {
+        // The point of the whole layer: adding vendors must not move the validated path.
+        for (policy in GpuPolicy.values()) {
+            val chosen = BackendRegistry.select(adreno, policy).chosen
+            if (policy == GpuPolicy.FORCE_SOFTWARE) {
+                assertEquals("lavapipe", chosen.backendId)
+            } else {
+                assertEquals("turnip", chosen.backendId)
+                assertEquals(Risk.SAFE, chosen.risk)
+                assertTrue(chosen.gpuInGuest)
+            }
+        }
+    }
+
+    @Test fun theDefaultPolicyNeverHandsAnUnvalidatedGpuToTheGuest() {
+        // Mali and Maleoon both default to CPU rendering: a slow session beats a kernel hang.
+        assertEquals("lavapipe", BackendRegistry.select(maliCsf, GpuPolicy.AUTO).chosen.backendId)
+        assertEquals("lavapipe", BackendRegistry.select(kirin9000, GpuPolicy.AUTO).chosen.backendId)
+        assertEquals("lavapipe", BackendRegistry.select(kirin9000s, GpuPolicy.AUTO).chosen.backendId)
+    }
+
+    @Test fun theDefaultPolicyStillOffersTheExperimentalPathInTheCandidates() {
+        // Auto does not use PanVK, but the device card has to be able to say it exists.
+        val decision = BackendRegistry.select(maliCsf, GpuPolicy.AUTO)
+        val panvk = decision.candidates.first { it.backendId == "panvk-kbase" }
+        assertEquals(Risk.EXPERIMENTAL, panvk.risk)
+        assertEquals(DriverRequirement.IMPORTED_ICD, panvk.driverRequirement)
+    }
+
+    @Test fun askingForHardwareOnAValidatedMaliGetsPanVk() {
+        val chosen = BackendRegistry.select(maliCsf, GpuPolicy.PREFER_HARDWARE).chosen
+        assertEquals("panvk-kbase", chosen.backendId)
+        assertEquals(Risk.EXPERIMENTAL, chosen.risk)
+        assertTrue(chosen.gpuInGuest)
+    }
+
+    @Test fun askingForHardwareStillDoesNotPickABlockedBackend() {
+        // Kirin 9000 is Job Manager, and the public PanVK-kbase builds are CSF-only.
+        val decision = BackendRegistry.select(kirin9000, GpuPolicy.PREFER_HARDWARE)
+        assertEquals("lavapipe", decision.chosen.backendId)
+        val blocked = decision.candidates.first { it.backendId == "panvk-kbase" }
+        assertEquals(Risk.BLOCKED, blocked.risk)
+        assertFalse(blocked.gpuInGuest)
+    }
+
+    @Test fun maleoonIsBlockedForHardwareAndExplainsWhy() {
+        val decision = BackendRegistry.select(kirin9000s, GpuPolicy.PREFER_HARDWARE)
+        assertEquals("lavapipe", decision.chosen.backendId)
+        val bridge = decision.candidates.first { it.backendId == "vendor-bridge" }
+        assertEquals(Risk.BLOCKED, bridge.risk)
+        assertTrue(bridge.reason.contains("bionic"))
+    }
+
+    @Test fun theMaliGpuIsBoundAsMaliAndNotDisguisedAsADrmNode() {
+        // Handing /dev/mali0 over as /dev/dri/renderD* invites DRM ioctls at a driver that never
+        // implemented them. PanVK opens the kbase node itself.
+        val panvk = BackendRegistry.select(maliCsf, GpuPolicy.PREFER_HARDWARE).chosen
+        assertEquals(listOf("/dev/mali0:/dev/mali0"), panvk.binds)
+        assertTrue(panvk.binds.none { it.contains("renderD") })
+        assertTrue(panvk.binds.none { it.contains("dri") })
+    }
+
+    @Test fun theCpuBackendNeverBindsAGpuNodeWhateverTheDevice() {
+        for (probe in listOf(adreno, maliCsf, kirin9000, kirin9000s)) {
+            val chosen = BackendRegistry.select(probe, GpuPolicy.FORCE_SOFTWARE).chosen
+            assertEquals("lavapipe", chosen.backendId)
+            assertEquals(DriverRequirement.CPU_SOFTWARE, chosen.driverRequirement)
+            assertTrue(chosen.binds.isEmpty())
+            assertFalse(chosen.gpuInGuest)
+        }
+    }
+
+    @Test fun thereIsAlwaysAnAnswer() {
+        // No device may fall through to "nothing can draw": that is the black-screen bug.
+        val unknown = GpuProbe.probe(FakeEnv())
+        for (probe in listOf(adreno, maliCsf, kirin9000, kirin9000s, unknown)) {
+            for (policy in GpuPolicy.values()) {
+                val decision = BackendRegistry.select(probe, policy)
+                assertTrue(decision.chosen.risk != Risk.BLOCKED)
+                assertTrue(decision.candidates.isNotEmpty())
+            }
+        }
+    }
+
+    @Test fun theMaliPlanCarriesTheTuningThatKeepsDxvkAlive() {
+        // Unified memory: without a capped heap DXVK allocates in 256 MiB chunks and dies.
+        val panvk = BackendRegistry.select(maliCsf, GpuPolicy.PREFER_HARDWARE).chosen
+        assertEquals("0.12", panvk.env["PANVK_HEAP_MEMORY_PERCENT"])
+        assertEquals("384", panvk.dxvk["dxvk.maxMemoryBudget"])
+        assertEquals("mali", panvk.env["BL_GPU_FAMILY"])
+    }
+}
