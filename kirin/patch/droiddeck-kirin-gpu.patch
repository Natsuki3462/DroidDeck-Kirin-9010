+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/KbaseInterface.kt
@@ -0,0 +1,23 @@
+package com.droiddeck.launcher.gpu.probe
+
+/**
+ * How a Mali-family kernel driver is reached, which decides whether a given PanVK build can talk to
+ * it at all.
+ *
+ * This is the detail that makes "Mali support" a family of backends rather than one: a build made
+ * for CSF cannot drive a Job Manager (JM) GPU, and a Kirin 9000 (G78, JM) is not a Mali-G615
+ * (Valhall v10, CSF) however similar the marketing name looks.
+ */
+enum class KbaseInterface(val label: String) {
+    /** Command Stream Frontend - Mali-G710/G715/G615 and newer (Valhall v10+). */
+    CSF("kbase CSF"),
+
+    /** Job Manager - Mali-G78 and older (Bifrost and Valhall v7-v9). */
+    JM("kbase JM"),
+
+    /** No kbase node found; the driver is either absent or something else entirely. */
+    NONE("no kbase node"),
+
+    /** A node exists but the interface generation could not be read. */
+    UNKNOWN("kbase, interface unknown"),
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/KirinCatalog.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/KirinCatalog.kt
new file mode 100644
index 0000000..fd04d63
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/KirinCatalog.kt
@@ -0,0 +1,107 @@
+package com.droiddeck.launcher.gpu.probe
+
+/**
+ * One Kirin SoC, described by what it means for a Linux guest rather than by its benchmark score.
+ *
+ * [era] is the load-bearing field. Kirin shipped two completely different GPU stacks under the same
+ * name: ARM's licensed Mali up to the 9000, then Huawei's own Maleoon from the 9000S on. A support
+ * matrix that treats "Kirin" as one thing is wrong for half the devices it names.
+ */
+data class KirinSoc(
+    /** Stable id used in reports and tests: "kirin9000", "kirin9000s". */
+    val id: String,
+    /** How a person says it: "Kirin 9000S". */
+    val marketing: String,
+    /** The GPU as the device reports it: "Mali-G78 MP24", "Maleoon 910". */
+    val gpu: String,
+    val vendor: GpuVendor,
+    val era: Era,
+    /** The kbase generation this GPU's kernel driver speaks, for Mali parts. */
+    val kbase: KbaseInterface,
+    /** Lowest Android API level the vendor shipped this SoC with. */
+    val minApi: Int,
+) {
+    enum class Era(val label: String) {
+        /** Bifrost: Mali-G71/G72. Valhall v7-v9: G76/G77/G78. ARM-licensed. */
+        MALI("ARM Mali (licensed)"),
+
+        /** Huawei's own GPU. No Mesa backend, no open driver, no guest path. */
+        MALEOON("Huawei Maleoon (in-house)"),
+    }
+
+    /** Whether any open-source Vulkan backend could ever drive this GPU from inside the guest. */
+    val hasOpenGuestDriver: Boolean get() = vendor == GpuVendor.ARM_MALI
+}
+
+/**
+ * The Kirin models a support decision can actually be made about.
+ *
+ * Only SoCs whose GPU is documented are listed; an unlisted Kirin is treated as unknown rather than
+ * guessed, because guessing a GPU generation is exactly how a wrong PanVK build gets shipped.
+ */
+object KirinCatalog {
+    private val M = GpuVendor.ARM_MALI
+    private val H = GpuVendor.HUAWEI_MALEOON
+    private val JM = KbaseInterface.JM
+    private val CSF = KbaseInterface.CSF
+
+    val entries: List<KirinSoc> = listOf(
+        KirinSoc("kirin960", "Kirin 960", "Mali-G71 MP8", M, KirinSoc.Era.MALI, JM, 24),
+        KirinSoc("kirin970", "Kirin 970", "Mali-G72 MP12", M, KirinSoc.Era.MALI, JM, 26),
+        KirinSoc("kirin980", "Kirin 980", "Mali-G76 MP10", M, KirinSoc.Era.MALI, JM, 28),
+        KirinSoc("kirin985", "Kirin 985", "Mali-G77 MP8", M, KirinSoc.Era.MALI, JM, 29),
+        KirinSoc("kirin990", "Kirin 990", "Mali-G76 MP16", M, KirinSoc.Era.MALI, JM, 29),
+        KirinSoc("kirin9000", "Kirin 9000", "Mali-G78 MP24", M, KirinSoc.Era.MALI, JM, 29),
+        KirinSoc("kirin9000e", "Kirin 9000E", "Mali-G78 MP22", M, KirinSoc.Era.MALI, JM, 30),
+        // The divide: everything below is Maleoon, and has no open guest driver at all.
+        KirinSoc("kirin9000s", "Kirin 9000S", "Maleoon 910", H, KirinSoc.Era.MALEOON, KbaseInterface.NONE, 31),
+        KirinSoc("kirin9010", "Kirin 9010", "Maleoon 910", H, KirinSoc.Era.MALEOON, KbaseInterface.NONE, 31),
+        KirinSoc("kirin9020", "Kirin 9020", "Maleoon 920", H, KirinSoc.Era.MALEOON, KbaseInterface.NONE, 31),
+        KirinSoc("kirin9020a", "Kirin 9020A", "Maleoon 920", H, KirinSoc.Era.MALEOON, KbaseInterface.NONE, 31),
+        KirinSoc("kirin9030", "Kirin 9030", "Maleoon 9xx", H, KirinSoc.Era.MALEOON, KbaseInterface.NONE, 31),
+        // Mid-range parts people actually play on.
+        KirinSoc("kirin810", "Kirin 810", "Mali-G52 MP6", M, KirinSoc.Era.MALI, JM, 28),
+        KirinSoc("kirin820", "Kirin 820", "Mali-G57 MP6", M, KirinSoc.Era.MALI, JM, 29),
+    )
+
+    private val byId: Map<String, KirinSoc> = entries.associateBy { it.id }
+
+    fun byId(id: String): KirinSoc? = byId[id.trim().lowercase()]
+
+    /**
+     * The Kirin a device is, from whatever strings it chose to expose.
+     *
+     * Huawei is not consistent here: `ro.board.platform` carries "kirin9000" on some builds,
+     * "hi3660" on older ones, and a marketing string on others, so every source is tried and the
+     * longest matching token wins - "kirin9000s" must not be read as "kirin9000".
+     */
+    fun identify(vararg candidates: String?): KirinSoc? {
+        val tokens = candidates.filterNotNull()
+            .flatMap { split(it) }
+        if (tokens.isEmpty()) return null
+        // Longest first so a more specific id beats its own prefix.
+        for (token in tokens.sortedByDescending { it.length }) {
+            byId[token]?.let { return it }
+        }
+        return null
+    }
+
+    private val LEGACY = mapOf(
+        "hi3660" to "kirin960", "hi3670" to "kirin970", "hi3680" to "kirin980",
+        "hi3690" to "kirin990", "hi6250" to "kirin659", "hi6210" to "kirin650",
+    )
+
+    /** Every "kirin####" / "hi####" token in a string, normalised. */
+    internal fun split(raw: String): List<String> {
+        val lower = raw.lowercase()
+        val out = mutableListOf<String>()
+        Regex("""kirin\s*-?\s*(\d{3,4}[a-z]?)(?!\d)""").findAll(lower).forEach {
+            out += "kirin" + it.groupValues[1]
+        }
+        Regex("""\b(hi\d{4})\b""").findAll(lower).forEach { m ->
+            out += m.groupValues[1]
+            LEGACY[m.groupValues[1]]?.let { out += it }
+        }
+        return out
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/ProbeEnv.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/ProbeEnv.kt
new file mode 100644
index 0000000..1d09a9a
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/ProbeEnv.kt
@@ -0,0 +1,66 @@
+package com.droiddeck.launcher.gpu.probe
+
+/**
+ * Everything the probe is allowed to look at, behind one interface.
+ *
+ * The point is not abstraction for its own sake: it is that a Kirin phone cannot be plugged into a
+ * build machine, so the only way a detection rule can be tested at all is to hand it a described
+ * device instead of a real one. [AndroidProbeEnv] reads the phone; tests read a map.
+ */
+interface ProbeEnv {
+    fun exists(path: String): Boolean
+
+    /** The file's text, or null when it is missing or unreadable. */
+    fun readText(path: String): String?
+
+    /** A system property, or "" when it is unset. */
+    fun property(name: String): String
+
+    /** File names directly inside [dir], or empty when it cannot be listed. */
+    fun list(dir: String): List<String>
+
+    /** Build.VERSION.SDK_INT. */
+    val sdkInt: Int
+
+    /** Build.HARDWARE. */
+    val hardware: String
+
+    /** Build.MANUFACTURER. */
+    val manufacturer: String
+
+    /** The Vulkan device name, when it has already been queried; null otherwise. */
+    val vulkanDeviceName: String?
+}
+
+/** The Vulkan driver libraries an Android device can carry, by vendor. */
+internal object DriverPaths {
+    /** Where Android's Vulkan HAL drivers live. Enumerated, not guessed - see [GpuProbe]. */
+    const val HW_DIR = "/vendor/lib64/hw"
+
+    const val ADRENO_VULKAN = "/vendor/lib64/hw/vulkan.adreno.so"
+    const val MALI_VULKAN = "/vendor/lib64/hw/vulkan.mali.so"
+    const val MALI_VULKAN_ALT = "/vendor/lib64/hw/vulkan.arm.mali.so"
+    const val MALI_EGL = "/vendor/lib64/egl/libGLES_mali.so"
+    const val MALEOON_VULKAN = "/vendor/lib64/hw/vulkan.maleoon.so"
+    const val MALEOON_EGL = "/vendor/lib64/egl/libGLES_maleoon.so"
+
+    /**
+     * Huawei's own Vulkan driver, which is what a Kirin 9010 actually ships.
+     *
+     * The name is `hvgr` ("Huawei GPU renderer") and not `maleoon`, which is the GPU's marketing
+     * name - a distinction only real hardware makes clear. Recorded from a Kirin 9010 handset:
+     * `/vendor/lib64/hw/vulkan.hvgr_v200.so`, with no `/dev/mali0` and no `/dev/dri` on the device.
+     */
+    const val HVGR_VULKAN = "/vendor/lib64/hw/vulkan.hvgr_v200.so"
+
+    const val XCLIPSE_VULKAN = "/vendor/lib64/hw/vulkan.xclipse.so"
+    const val POWERVR_VULKAN = "/vendor/lib64/hw/vulkan.powerVR.so"
+
+    const val KGSL = "/sys/class/kgsl/kgsl-3d0"
+    const val MALI_DEV = "/dev/mali0"
+    const val MALI_SYS = "/sys/class/misc/mali0"
+
+    /** Written by mali_kbase: "1" or a version string on CSF kernels. */
+    const val MALI_CSF = "/sys/class/misc/mali0/device/csf_version"
+    const val MALI_CSF_ALT = "/sys/class/misc/mali0/csf_version"
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/RenderBackend.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/RenderBackend.kt
new file mode 100644
index 0000000..d40046b
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/RenderBackend.kt
@@ -0,0 +1,56 @@
+package com.droiddeck.launcher.gpu.probe
+
+/**
+ * How much is known about a backend actually working, as opposed to how likely it looks.
+ *
+ * [SAFE] is reserved for paths that have been validated on hardware this project ships support for.
+ * [BLOCKED] is not "we have not tried it": it means the path cannot work at all on this device, and
+ * offering it would only produce a black screen with nothing in it to read.
+ */
+enum class Risk { SAFE, EXPERIMENTAL, BLOCKED }
+
+/** What a backend needs installed before it can draw anything. */
+enum class DriverRequirement {
+    /** The driver built into the Linux runtime. Adreno's Turnip. */
+    RUNTIME_DEFAULT,
+
+    /** A driver the user has to import explicitly, because shipping it is not defensible. */
+    IMPORTED_ICD,
+
+    /** A CPU renderer, so no GPU driver is involved at all. */
+    CPU_SOFTWARE,
+
+    /** Nothing can draw. The backend exists only to explain why. */
+    NONE_AVAILABLE,
+}
+
+/**
+ * A backend's answer for one device: what it would do, and what it costs.
+ *
+ * This is data, not behaviour, so the choice between backends can be asserted in a unit test on a
+ * machine with no phone attached - which is the whole reason the layer exists.
+ */
+data class BackendPlan(
+    val backendId: String,
+    val displayName: String,
+    val risk: Risk,
+    /** Whether the guest is handed the GPU's kernel node at all. */
+    val gpuInGuest: Boolean,
+    val driverRequirement: DriverRequirement,
+    /** Guest environment this backend adds. The ICD path is not here: the caller composes it. */
+    val env: Map<String, String> = emptyMap(),
+    /** DXVK settings this backend needs, as `dxvk.conf` keys. */
+    val dxvk: Map<String, String> = emptyMap(),
+    /** Host-to-guest binds, in `src:dst` form. */
+    val binds: List<String> = emptyList(),
+    /** Why this is the answer, in one sentence a bug report can quote. */
+    val reason: String,
+)
+
+/** One way of drawing a Linux session on an Android GPU. */
+interface RenderBackend {
+    val id: String
+
+    /** What this backend can do on [probe], or null when the device is not its business. */
+    fun evaluate(probe: GpuProbeResult): BackendPlan?
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/SessionGpu.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/SessionGpu.kt
new file mode 100644
index 0000000..257086d
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/SessionGpu.kt
@@ -0,0 +1,185 @@
+package com.droiddeck.launcher.gpu.probe
+
+import android.content.Context
+import android.util.Log
+import com.droiddeck.launcher.core.CpuCores
+import com.droiddeck.launcher.gpu.LinuxVulkanDriverManager
+import com.droiddeck.launcher.session.SessionPrefs
+
+/**
+ * What the session needs from the backend decision, in the terms the guest understands.
+ *
+ * The point of this type is that the session should not have to reason about GPUs. It asks one
+ * question - "what do I put in the guest's environment, and at what size" - and gets an answer that
+ * is already specific to this device.
+ *
+ * [keepAdrenoDefaults] is the load-bearing field: when it is true the session writes exactly the
+ * environment it has always written, character for character. Nothing about the Adreno path may
+ * change because other vendors were added beside it.
+ */
+data class SessionGpuPlan(
+    val backendId: String,
+    val risk: Risk,
+    /** The guest draws on the CPU: no GPU node, no vendor driver, a software Vulkan ICD. */
+    val software: Boolean,
+    /** True when the session should write its own long-standing Adreno environment unchanged. */
+    val keepAdrenoDefaults: Boolean,
+    /** Vulkan ICD manifest for the guest, or null to keep the runtime's own. */
+    val icdPath: String?,
+    /**
+     * Directory holding the driver and the libraries it links against.
+     *
+     * A CPU renderer is not one file: lavapipe needs its LLVM and its X/Wayland shims beside it, and
+     * the dynamic loader only looks in default paths. The session puts this directory on the guest's
+     * `LD_LIBRARY_PATH` so those are found.
+     */
+    val libraryDir: String?,
+    /** A software session was asked for but no CPU Vulkan driver has been imported. */
+    val missingSoftwareDriver: Boolean,
+    /** Guest environment this plan adds. Empty when [keepAdrenoDefaults] is set. */
+    val env: Map<String, String>,
+    /** Render scale for the session output, in percent of the chosen size. 100 leaves it alone. */
+    val resolutionScalePercent: Int,
+    /** Refresh rate to cap the session at. 0 leaves it alone. */
+    val maxRefreshHz: Int,
+    val reason: String,
+)
+
+/**
+ * Turns a [BackendDecision] into a [SessionGpuPlan].
+ *
+ * Everything except [plan] itself is pure, so the mapping can be asserted on a build machine. The
+ * Android-facing part only looks up two things: which driver packs are installed, and how many cores
+ * the device has.
+ */
+object SessionGpu {
+    private const val TAG = "SessionGpu"
+
+    /** Backend ids whose environment the session already writes itself. */
+    private const val ADRENO_BACKEND = "turnip"
+
+    /**
+     * Whether a driver pack is a CPU renderer, by whatever name its author gave it.
+     *
+     * These are matched as whole words: "lvp" inside another word is not evidence of anything.
+     */
+    fun isSoftwareDriverName(text: String?): Boolean {
+        if (text.isNullOrBlank()) return false
+        val lower = text.lowercase()
+        if (lower.contains("lavapipe") || lower.contains("llvmpipe") ||
+            lower.contains("swrast") || lower.contains("softpipe")
+        ) return true
+        return lower.split(Regex("[^a-z0-9]+")).any { it == "lvp" }
+    }
+
+    /** The first imported driver pack that is a CPU renderer, or null. */
+    fun softwareDriverId(context: Context): String? {
+        val manager = LinuxVulkanDriverManager(context)
+        return pickSoftwareDriver(
+            installed = manager.enumerateInstalledDrivers(),
+            chosen = SessionPrefs.linuxDriver(context),
+            nameOf = manager::getDriverName,
+        )
+    }
+
+    /**
+     * Which CPU renderer to use when more than one is installed.
+     *
+     * The driver picked on the Components screen wins. Picking one there and then having the
+     * session quietly use a different one is the sort of thing that makes people stop trusting the
+     * screen - and it is what happened the first time two lavapipe packs were installed side by
+     * side, because the old code simply took the first id in alphabetical order.
+     */
+    fun pickSoftwareDriver(installed: List<String>, chosen: String, nameOf: (String) -> String): String? {
+        fun isSoftware(id: String) = isSoftwareDriverName(id) || isSoftwareDriverName(nameOf(id))
+        if (chosen.isNotEmpty() && chosen in installed && isSoftware(chosen)) return chosen
+        return installed.firstOrNull { isSoftware(it) }
+    }
+
+    /**
+     * The session's output size after the device profile's render scale.
+     *
+     * Rounded to an even number because a half-pixel edge shows up as a seam once the compositor
+     * scales the frame back to the panel, and floored at 320 so a small profile cannot produce a
+     * size gamescope refuses.
+     */
+    fun scaledOutput(value: Int, percent: Int): Int =
+        if (percent >= 100) value
+        else ((value.toLong() * percent / 100).toInt() / 2 * 2).coerceAtLeast(320)
+
+    /** The plan for this device under the user's current setting. */
+    fun plan(context: Context): SessionGpuPlan {
+        val probe = GpuBackends.probe()
+        val decision = BackendRegistry.select(probe, GpuBackends.policy(context))
+        val tuning = DeviceProfiles.forProbe(probe, CpuCores.all.size)
+        val softwareIcd = if (decision.software) softwareDriverId(context)?.let {
+            LinuxVulkanDriverManager(context).getIcdPath(it)
+        } else {
+            null
+        }
+        return plan(decision, softwareIcd, tuning)
+    }
+
+    fun plan(
+        decision: BackendDecision,
+        softwareIcd: String?,
+        tuning: SessionTuning?,
+    ): SessionGpuPlan {
+        val chosen = decision.chosen
+        if (!decision.software) {
+            // A GPU session: Adreno keeps its own environment, and a Mali one brings its own.
+            val adreno = chosen.backendId == ADRENO_BACKEND
+            return SessionGpuPlan(
+                backendId = chosen.backendId,
+                risk = chosen.risk,
+                software = false,
+                keepAdrenoDefaults = adreno,
+                icdPath = null,
+                libraryDir = null,
+                missingSoftwareDriver = false,
+                env = if (adreno) emptyMap() else chosen.env,
+                resolutionScalePercent = 100,
+                maxRefreshHz = 0,
+                reason = chosen.reason,
+            )
+        }
+        // A CPU session: the backend's own environment, plus whatever the device profile adds.
+        val env = LinkedHashMap<String, String>()
+        env.putAll(chosen.env)
+        tuning?.env?.let { env.putAll(it) }
+        return SessionGpuPlan(
+            backendId = chosen.backendId,
+            risk = chosen.risk,
+            software = true,
+            keepAdrenoDefaults = false,
+            icdPath = softwareIcd,
+            libraryDir = softwareIcd?.substringBeforeLast('/', "")?.ifEmpty { null },
+            missingSoftwareDriver = softwareIcd == null,
+            env = env,
+            resolutionScalePercent = tuning?.resolutionScalePercent?.coerceIn(10, 100) ?: 100,
+            maxRefreshHz = tuning?.maxRefreshHz ?: 0,
+            reason = chosen.reason,
+        )
+    }
+
+    /** One line for the session log, so a bug report says which path drew the frame. */
+    fun describe(plan: SessionGpuPlan): String = buildString {
+        append("gpu: ").append(plan.backendId).append(" [").append(plan.risk.name).append(']')
+        if (plan.software) {
+            append(" · software")
+            append(if (plan.icdPath != null) " (icd ${plan.icdPath})" else " (no CPU Vulkan driver imported)")
+            if (plan.resolutionScalePercent != 100) append(" · ${plan.resolutionScalePercent}%")
+            if (plan.maxRefreshHz > 0) append(" · ${plan.maxRefreshHz} Hz cap")
+        } else {
+            append(" · gpu in guest")
+        }
+    }
+
+    fun log(plan: SessionGpuPlan) {
+        if (plan.software && plan.missingSoftwareDriver) {
+            Log.e(TAG, "software session but no CPU Vulkan driver is imported: the guest will have no " +
+                "Vulkan device. Import a lavapipe pack under Components > GPU drivers.")
+        }
+        Log.i(TAG, describe(plan))
+    }
+}
