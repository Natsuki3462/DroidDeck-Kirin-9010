index 0000000..0f29218
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/AndroidProbeEnv.kt
@@ -0,0 +1,70 @@
+package com.droiddeck.launcher.gpu.probe
+
+import android.content.Context
+import android.os.Build
+import com.droiddeck.launcher.core.FileUtils
+import com.droiddeck.launcher.gpu.GpuInfo
+import com.droiddeck.launcher.gpu.VulkanInfo
+import com.droiddeck.launcher.session.SessionPrefs
+import java.io.File
+
+/** The real device, read the way the rest of the app already reads it. */
+object AndroidProbeEnv : ProbeEnv {
+    override fun exists(path: String): Boolean = File(path).exists()
+
+    override fun readText(path: String): String? = FileUtils.readString(File(path))
+
+    override fun property(name: String): String = GpuInfo.systemProperty(name)
+
+    override fun list(dir: String): List<String> = File(dir).list()?.toList().orEmpty()
+
+    override val sdkInt: Int get() = Build.VERSION.SDK_INT
+
+    override val hardware: String get() = Build.HARDWARE
+
+    override val manufacturer: String get() = Build.MANUFACTURER
+
+    override val vulkanDeviceName: String? get() = VulkanInfo.cachedOrNull()?.get("device")
+}
+
+/**
+ * The one place the app asks "what GPU is this, and what should draw with it".
+ *
+ * Callers should not reach for [GpuProbe] or [BackendRegistry] directly: the probe is cheap but not
+ * free (it stats a handful of vendor paths), and the decision has to be the same everywhere or the
+ * driver card and the session disagree about the device.
+ */
+object GpuBackends {
+
+    /** Probe without policy. Cheap enough to call from a settings screen; not from a draw loop. */
+    @JvmStatic
+    fun probe(): GpuProbeResult = GpuProbe.probe(AndroidProbeEnv)
+
+    /** The HarmonyOS build this device runs, for the card that explains the session's limits. */
+    @JvmStatic
+    fun harmonyOs(): HarmonyOs = HarmonyOs.detect(AndroidProbeEnv)
+
+    @JvmStatic
+    fun policy(context: Context): GpuPolicy = when (SessionPrefs.gpuBackend(context)) {
+        SessionPrefs.GPU_BACKEND_HARDWARE -> GpuPolicy.PREFER_HARDWARE
+        SessionPrefs.GPU_BACKEND_SOFTWARE -> GpuPolicy.FORCE_SOFTWARE
+        else -> GpuPolicy.AUTO
+    }
+
+    @JvmStatic
+    fun setPolicy(context: Context, policy: GpuPolicy) {
+        SessionPrefs.setGpuBackend(context, when (policy) {
+            GpuPolicy.AUTO -> SessionPrefs.GPU_BACKEND_AUTO
+            GpuPolicy.PREFER_HARDWARE -> SessionPrefs.GPU_BACKEND_HARDWARE
+            GpuPolicy.FORCE_SOFTWARE -> SessionPrefs.GPU_BACKEND_SOFTWARE
+        })
+    }
+
+    /** The backend this device uses under the user's setting. */
+    @JvmStatic
+    fun decide(context: Context): BackendDecision = decide(probe(), policy(context))
+
+    @JvmStatic
+    fun decide(probe: GpuProbeResult, policy: GpuPolicy): BackendDecision =
+        BackendRegistry.select(probe, policy)
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/BackendRegistry.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/BackendRegistry.kt
new file mode 100644
index 0000000..eb4179b
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/BackendRegistry.kt
@@ -0,0 +1,90 @@
+package com.droiddeck.launcher.gpu.probe
+
+import com.droiddeck.launcher.gpu.probe.backends.LavapipeBackend
+import com.droiddeck.launcher.gpu.probe.backends.PanVkKbaseBackend
+import com.droiddeck.launcher.gpu.probe.backends.TurnipBackend
+import com.droiddeck.launcher.gpu.probe.backends.VendorBridgeBackend
+
+/**
+ * How much the user has asked for the GPU to be used.
+ *
+ * [AUTO] is what an install that never chose anything gets, and it is deliberately the conservative
+ * one: hardware only where the path is validated. Asking for the experimental Mali driver is a
+ * separate, explicit act, because the failure mode is not "a game runs badly" - it is a kernel hang.
+ */
+enum class GpuPolicy {
+    /** Only validated backends; anything else falls back to CPU rendering. */
+    AUTO,
+
+    /** Best available backend, including experimental ones, but never a blocked one. */
+    PREFER_HARDWARE,
+
+    /** CPU rendering whatever the device is. */
+    FORCE_SOFTWARE,
+}
+
+/** The chosen backend, plus every backend that had an opinion, for the device card and reports. */
+data class BackendDecision(
+    val chosen: BackendPlan,
+    val candidates: List<BackendPlan>,
+    val policy: GpuPolicy,
+) {
+    /** Whether the guest is kept away from the GPU entirely. */
+    val software: Boolean get() = !chosen.gpuInGuest
+}
+
+/**
+ * The ordered list of backends, and the one rule that picks between them.
+ *
+ * Order is the tie-break: when two backends carry the same risk, the earlier one wins, so the list
+ * reads as a preference order and the selection stays deterministic without a scoring scheme nobody
+ * can reason about.
+ */
+object BackendRegistry {
+
+    /** Preference order. Adreno first because it is the validated path. */
+    val backends: List<RenderBackend> = listOf(
+        TurnipBackend,
+        PanVkKbaseBackend,
+        LavapipeBackend,
+        VendorBridgeBackend,
+    )
+
+    fun evaluate(probe: GpuProbeResult, backends: List<RenderBackend> = this.backends): List<BackendPlan> =
+        backends.mapNotNull { it.evaluate(probe) }
+
+    /**
+     * The backend this device should use under [policy].
+     *
+     * A blocked plan is never chosen, even by [GpuPolicy.PREFER_HARDWARE]: blocked means it cannot
+     * work, not that it is untested. If nothing usable is left, CPU rendering is chosen - which is
+     * always available, and is the reason this function has no null case.
+     */
+    fun select(
+        probe: GpuProbeResult,
+        policy: GpuPolicy = GpuPolicy.AUTO,
+        backends: List<RenderBackend> = this.backends,
+    ): BackendDecision {
+        val candidates = evaluate(probe, backends)
+        val usable = candidates.filter { it.risk != Risk.BLOCKED }
+
+        val chosen = when (policy) {
+            GpuPolicy.FORCE_SOFTWARE -> usable.firstOrNull { it.driverRequirement == DriverRequirement.CPU_SOFTWARE }
+            GpuPolicy.AUTO -> usable.firstOrNull { it.risk == Risk.SAFE }
+            // Asking for hardware means hardware: a SAFE CPU renderer must not win this one, or the
+            // setting would do nothing on the only devices it exists for.
+            GpuPolicy.PREFER_HARDWARE -> usable
+                .filter { it.driverRequirement != DriverRequirement.CPU_SOFTWARE }
+                .minByOrNull { rank(it.risk) }
+        } ?: usable.firstOrNull { it.driverRequirement == DriverRequirement.CPU_SOFTWARE }
+            ?: LavapipeBackend.evaluate(probe)
+
+        return BackendDecision(chosen = chosen, candidates = candidates, policy = policy)
+    }
+
+    private fun rank(risk: Risk): Int = when (risk) {
+        Risk.SAFE -> 0
+        Risk.EXPERIMENTAL -> 1
+        Risk.BLOCKED -> 2
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/DeviceProfiles.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/DeviceProfiles.kt
new file mode 100644
index 0000000..a350c54
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/DeviceProfiles.kt
@@ -0,0 +1,84 @@
+package com.droiddeck.launcher.gpu.probe
+
+/**
+ * Session settings a particular device needs, as opposed to the ones a person would pick.
+ *
+ * This exists because of one device class in particular: a Kirin 9010 has no Linux GPU driver, so
+ * every session on it is drawn by the CPU. On that path the defaults the app ships - full panel
+ * resolution, frame generation, FSR - are not "a bit heavy", they are the difference between a
+ * session that comes up and one that does not, and the user has no way to know which knob mattered.
+ *
+ * Null means "nothing device-specific": the app's own defaults are already right.
+ */
+data class SessionTuning(
+    /** Short name for the device card: "Kirin 9010 (software)". */
+    val label: String,
+    /** Render scale the session should start at, in percent of the panel. */
+    val resolutionScalePercent: Int,
+    /** Refresh rate to cap the session at, in Hz. */
+    val maxRefreshHz: Int,
+    /** Whether frame generation is worth offering at all. */
+    val frameGeneration: Boolean,
+    /** Whether the upscaler is worth offering at all. */
+    val upscaling: Boolean,
+    /** Guest environment this device needs on top of its backend's. */
+    val env: Map<String, String> = emptyMap(),
+    /** Why these numbers, in a sentence a bug report can quote. */
+    val notes: List<String> = emptyList(),
+)
+
+/**
+ * The per-device settings worth having an opinion about.
+ *
+ * Keyed by SoC rather than by phone model: the phones a SoC ships in differ in screen and RAM, but
+ * the reason the tuning is needed is the GPU, which they share.
+ */
+object DeviceProfiles {
+
+    /** SoCs whose only path today is CPU rendering: Maleoon 910 (9000S, 9010) and 920 (9020). */
+    private val MALEOON_SOCS = setOf("kirin9000s", "kirin9010", "kirin9020", "kirin9020a", "kirin9030")
+
+    fun forProbe(probe: GpuProbeResult, cpuCores: Int = 8): SessionTuning? {
+        val soc = probe.kirin?.id ?: return null
+        if (soc in MALEOON_SOCS) return maleoon(probe.kirin, cpuCores)
+        return null
+    }
+
+    /**
+     * Maleoon: software rendering, and tuned for it.
+     *
+     * The render scale is the one number that matters most - lavapipe's cost is close to linear in
+     * pixels, so 60% of a 1220p panel is roughly 2.8x less work per frame than 100%. Threads are
+     * capped below the core count because Android's own compositor and the Steam client need cores
+     * too, and starving them turns a slow session into a stuttering one.
+     */
+    private fun maleoon(soc: KirinSoc, cpuCores: Int): SessionTuning {
+        val threads = (cpuCores - 2).coerceIn(2, 6)
+        return SessionTuning(
+            label = "${soc.marketing} (software)",
+            resolutionScalePercent = 60,
+            maxRefreshHz = 60,
+            frameGeneration = false,
+            upscaling = false,
+            env = mapOf(
+                // lavapipe worker threads: leave the rest of the SoC for Android and Steam.
+                "LP_NUM_THREADS" to threads.toString(),
+                // Shader compilation is the main stall on a CPU renderer; keep it on disk.
+                "MESA_SHADER_CACHE_DIR" to "/var/cache/droiddeck/mesa",
+                "MESA_SHADER_CACHE_DISABLE" to "false",
+            ),
+            notes = listOf(
+                "${soc.marketing} carries ${soc.gpu}, which has no Linux driver: the session draws on the CPU.",
+                "Frame generation and the upscaler are off because both need a Vulkan device.",
+                "Expect the launcher and desktop to be usable and games to be slow; that is the renderer, not a setting.",
+                // Every Maleoon device is a Huawei one, and Huawei's killer is not AOSP's.
+                "HarmonyOS's low-memory killer is stricter than AOSP's: the container's processes need a " +
+                    "non-zero oom_score_adj, or one spike kills the whole session rather than one game.",
+                // Measured on a Kirin 9010 handset: 1260x2844, so a landscape session is 2844x1260 and
+                // 60% of that is 1706x756. The figure is a starting point, not a measurement of what
+                // the phone can hold; it is the first thing to raise if the session feels soft.
+                "60% of a 2844x1260 landscape panel is 1706x756; raise the scale only after measuring.",
+            ),
+        )
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/GpuProbe.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/GpuProbe.kt
new file mode 100644
index 0000000..44550bc
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/probe/GpuProbe.kt
@@ -0,0 +1,216 @@
+package com.droiddeck.launcher.gpu.probe
+
+/**
+ * What the probe concluded about this device's GPU, in the terms a backend is chosen by.
+ *
+ * Everything here is read-only fact plus one derived judgement ([vendor]); no policy lives in it.
+ * The rule that decides whether the GPU is handed to a guest belongs to [RenderBackend].
+ */
+data class GpuProbeResult(
+    val vendor: GpuVendor,
+    /** The GPU as this device names it: "Adreno 740", "Mali-G78 MP24", "Maleoon 910". */
+    val deviceName: String,
+    /** The three-digit Adreno model, or 0. Unchanged from the Adreno-only probe, for the driver lists. */
+    val adrenoModel: Int,
+    /** Which kbase generation the Mali kernel driver speaks, when there is one. */
+    val kbase: KbaseInterface,
+    /** The Kirin SoC this is, when the device is a Kirin at all. */
+    val kirin: KirinSoc?,
+    /** The kernel node the GPU is reached through, when one was found. */
+    val kernelNode: String?,
+    /** The vendor's Vulkan library, when one was found. */
+    val driverLib: String?,
+    val sdkInt: Int,
+) {
+    /** Whether this is the one path the app has actually been validated on. */
+    val isAdreno: Boolean get() = vendor == GpuVendor.QUALCOMM
+
+    /** A Mali-era Kirin (Kirin 9000 and older): licensed Mali, so a Mesa backend can exist. */
+    val isMaliKirin: Boolean get() = vendor == GpuVendor.ARM_MALI
+
+    /** A Maleoon-era Kirin (Kirin 9000S and newer): Huawei's own GPU, no Mesa backend exists. */
+    val isMaleoonKirin: Boolean get() = vendor == GpuVendor.HUAWEI_MALEOON
+
+    /** One line for the device card and the report. */
+    fun summary(): String = buildString {
+        append(deviceName)
+        kirin?.let { append(" · ").append(it.marketing).append(" (").append(it.era.label).append(')') }
+        if (kbase != KbaseInterface.NONE) append(" · ").append(kbase.label)
+    }
+}
+
+/**
+ * Reads a device and says what its GPU is.
+ *
+ * Detection is by evidence, never by brand: a Huawei phone whose GPU reports "Maleoon 910" is Maleoon
+ * whatever its SoC table says, and a phone with only `/dev/mali0` and no SoC match is still Mali. The
+ * order below is the priority order - Adreno first because it is the only vendor whose node and
+ * driver are unambiguous, then Huawei's own GPU, then ARM's.
+ *
+ * Driver libraries are **enumerated, not guessed**. A Kirin 9010 handset ships its Vulkan driver as
+ * `/vendor/lib64/hw/vulkan.hvgr_v200.so` - `hvgr`, not `maleoon`, and the device has no `/dev/mali0`
+ * and no `/dev/dri` at all. Hard-coding the name the marketing material suggests would have missed
+ * the device entirely, so [driverLibs] lists the HAL directory and classifies what it finds.
+ */
+object GpuProbe {
+
+    fun probe(env: ProbeEnv): GpuProbeResult {
+        val vulkanName = env.vulkanDeviceName.orEmpty()
+        val kirin = KirinCatalog.identify(
+            env.property("ro.board.platform"),
+            env.property("ro.soc.model"),
+            env.property("ro.hardware"),
+            env.hardware,
+            env.property("ro.vendor.product.device"),
+        )
+        val libs = driverLibs(env)
+        val maliNode = listOf(DriverPaths.MALI_DEV, DriverPaths.MALI_SYS).firstOrNull { env.exists(it) }
+
+        // 1. Adreno: kgsl's node, or Qualcomm's own Vulkan driver, is proof on its own.
+        if (env.exists(DriverPaths.KGSL) || libs.containsKey(GpuVendor.QUALCOMM)) {
+            val model = adrenoModel(env, vulkanName)
+            return GpuProbeResult(
+                vendor = GpuVendor.QUALCOMM,
+                deviceName = if (model > 0) "Adreno $model" else "Adreno",
+                adrenoModel = model,
+                kbase = KbaseInterface.NONE,
+                kirin = kirin,
+                kernelNode = DriverPaths.KGSL.takeIf { env.exists(it) },
+                driverLib = libs[GpuVendor.QUALCOMM],
+                sdkInt = env.sdkInt,
+            )
+        }
+
+        // 2. Maleoon: the GPU's own name, Huawei's driver, or a Maleoon-era Kirin with no Mali node.
+        val maleoonNamed = vulkanName.contains("maleoon", ignoreCase = true)
+        if (maleoonNamed || libs.containsKey(GpuVendor.HUAWEI_MALEOON) ||
+            (kirin?.era == KirinSoc.Era.MALEOON && maliNode == null)
+        ) {
+            return GpuProbeResult(
+                vendor = GpuVendor.HUAWEI_MALEOON,
+                deviceName = maleoonName(vulkanName) ?: kirin?.gpu ?: "Maleoon",
+                adrenoModel = 0,
+                kbase = KbaseInterface.NONE,
+                kirin = kirin,
+                kernelNode = null,
+                driverLib = libs[GpuVendor.HUAWEI_MALEOON],
+                sdkInt = env.sdkInt,
+            )
+        }
+
+        // 3. ARM Mali: a kbase node, or ARM's own driver libraries.
+        if (maliNode != null || libs.containsKey(GpuVendor.ARM_MALI)) {
+            return GpuProbeResult(
+                vendor = GpuVendor.ARM_MALI,
+                deviceName = maliName(vulkanName) ?: kirin?.gpu ?: "Mali",
+                adrenoModel = 0,
+                kbase = kbaseInterface(env, maliNode, kirin),
+                kirin = kirin,
+                kernelNode = maliNode,
+                driverLib = libs[GpuVendor.ARM_MALI],
+                sdkInt = env.sdkInt,
+            )
+        }
+
+        // 4. Named-but-unsupported vendors, so the card can say why rather than "unknown".
+        val named = when {
+            libs.containsKey(GpuVendor.SAMSUNG_XCLIPSE) || vulkanName.contains("xclipse", true) ->
+                GpuVendor.SAMSUNG_XCLIPSE
+            libs.containsKey(GpuVendor.IMAGINATION) || vulkanName.contains("powervr", true) ->
+                GpuVendor.IMAGINATION
+            else -> GpuVendor.UNKNOWN
+        }
+        return GpuProbeResult(
+            vendor = named,
+            deviceName = vulkanName.ifBlank { env.hardware.ifBlank { "this GPU" } },
+            adrenoModel = 0,
+            kbase = KbaseInterface.NONE,
+            kirin = kirin,
+            kernelNode = null,
+            driverLib = libs[named],
+            sdkInt = env.sdkInt,
+        )
+    }
+
+    /**
+     * Every vendor Vulkan driver installed, by vendor.
+     *
+     * Known paths first, because they are cheap; then the HAL directory is listed so a vendor that
+     * names its driver something unexpected is still found. First match per vendor wins.
+     */
+    internal fun driverLibs(env: ProbeEnv): Map<GpuVendor, String> {
+        val out = LinkedHashMap<GpuVendor, String>()
+        val known = listOf(
+            DriverPaths.ADRENO_VULKAN to GpuVendor.QUALCOMM,
+            DriverPaths.MALEOON_VULKAN to GpuVendor.HUAWEI_MALEOON,
+            DriverPaths.HVGR_VULKAN to GpuVendor.HUAWEI_MALEOON,
+            DriverPaths.MALI_VULKAN to GpuVendor.ARM_MALI,
+            DriverPaths.MALI_VULKAN_ALT to GpuVendor.ARM_MALI,
+            DriverPaths.XCLIPSE_VULKAN to GpuVendor.SAMSUNG_XCLIPSE,
+            DriverPaths.POWERVR_VULKAN to GpuVendor.IMAGINATION,
+        )
+        for ((path, vendor) in known) if (env.exists(path)) out.putIfAbsent(vendor, path)
+        for (name in env.list(DriverPaths.HW_DIR)) {
+            val vendor = vendorOfDriverFile(name) ?: continue
+            out.putIfAbsent(vendor, "${DriverPaths.HW_DIR}/$name")
+        }
+        return out
+    }
+
+    /** Which vendor a HAL driver file belongs to, from its name alone. */
+    internal fun vendorOfDriverFile(name: String): GpuVendor? {
+        val n = name.lowercase()
+        if (!n.startsWith("vulkan") || !n.endsWith(".so")) return null
+        return when {
+            n.contains("adreno") -> GpuVendor.QUALCOMM
+            // Huawei ships its GPU driver as "hvgr" (GPU renderer); "maleoon" is the marketing name.
+            n.contains("hvgr") || n.contains("maleoon") -> GpuVendor.HUAWEI_MALEOON
+            n.contains("mali") -> GpuVendor.ARM_MALI
+            n.contains("xclipse") -> GpuVendor.SAMSUNG_XCLIPSE
+            n.contains("powervr") -> GpuVendor.IMAGINATION
+            else -> null
+        }
+    }
+
+    /**
+     * CSF or JM.
+     *
+     * kbase does not expose the generation in one portable file, so this reads what it can and
+     * falls back to what the SoC is known to be - and says "unknown" rather than guessing when both
+     * are silent, because a wrong answer here picks a driver that cannot work.
+     */
+    internal fun kbaseInterface(env: ProbeEnv, node: String?, kirin: KirinSoc?): KbaseInterface {
+        if (node == null) return KbaseInterface.NONE
+        for (path in listOf(DriverPaths.MALI_CSF, DriverPaths.MALI_CSF_ALT)) {
+            val text = env.readText(path)?.trim()
+            if (!text.isNullOrEmpty() && text != "0") return KbaseInterface.CSF
+        }
+        // A CSF kernel names its firmware node; JM kernels do not.
+        if (env.exists("/sys/class/misc/mali0/device/csf_fw_version")) return KbaseInterface.CSF
+        return kirin?.kbase?.takeIf { it != KbaseInterface.NONE } ?: KbaseInterface.UNKNOWN
+    }
+
+    internal fun adrenoModel(env: ProbeEnv, vulkanName: String): Int {
+        val fromKernel = threeDigits(env.readText("/sys/class/kgsl/kgsl-3d0/gpu_model").orEmpty())
+        if (fromKernel > 0) return fromKernel
+        val fromVulkan = threeDigits(vulkanName)
+        if (fromVulkan > 0) return fromVulkan
+        return 0
+    }
+
+    /** Same rule the Adreno probe has always used: "Adreno740v2", "Adreno (TM) 830". */
+    internal fun threeDigits(text: String): Int =
+        Regex("""(?i)\badreno\s*(?:\(TM\)\s*)?(\d{3})(?!\d)""").find(text)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+
+    /** "Mali-G78" from a Vulkan name, when it carries one. */
+    internal fun maliName(vulkanName: String): String? =
+        Regex("""((?:Mali|Immortalis)-[GT]\d{2,4}(?:\s+MC\d+)?)""", RegexOption.IGNORE_CASE)
+            .find(vulkanName)?.groupValues?.get(1)
+
+    /** "Maleoon 910" from a Vulkan name, when it carries one. Spacing is normalised. */
+    internal fun maleoonName(vulkanName: String): String? {
+        val digits = Regex("""Maleoon\s*(\d{3})""", RegexOption.IGNORE_CASE)
+            .find(vulkanName)?.groupValues?.get(1) ?: return null
+        return "Maleoon $digits"
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/probe/GpuVendor.kt b/app/src/main/java/com/droiddeck/launcher/gpu/probe/GpuVendor.kt
